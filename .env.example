# Base URL to the deployed/running cb-indexer HTTP MCP service.
# Default: http://127.0.0.1:43770
CB_INDEXER_URL=http://127.0.0.1:43770

# Secret token for authenticating with cb-indexer (must match CB_INDEXER_AUTH_TOKEN on indexer).
# Leave empty if cb-indexer has no authentication configured.
CB_INDEXER_AUTH_TOKEN=
